# Copy this file to .env.local and fill in real values yourself.
# .env.local is gitignored — values never get committed or seen by anyone else.
# For production, set the same variables in Vercel → Project Settings → Environment Variables.

# --- Supabase ---
# Project Settings → API. Create project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only, bypasses RLS) — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Voyage AI (embeddings) ---
# https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address/domain in Resend
RESEND_FROM_EMAIL=

# --- Firecrawl (optional, for JS-heavy / feed-less sources) ---
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- Cron / internal auth ---
# Random secret string you generate yourself; checked on /api/agent/run
# to stop the endpoint being triggered by anyone but Vercel Cron or the dashboard.
CRON_SECRET=
